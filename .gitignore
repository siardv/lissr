# admit maintained paths and file types; update this list for new asset types
*

# public repository metadata and documentation
!/.gitignore
!/.Rbuildignore
!/CITATION.cff
!/DESCRIPTION
!/LICENSE
!/LICENSE.md
!/NAMESPACE
!/NEWS.md
!/README.md
!/_pkgdown.yml

# open each parent before admitting its contents
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/workflows/*.yaml
!/R/
!/R/*.[Rr]
!/man/
!/man/*.Rd
!/tests/
!/tests/testthat.R
!/tests/testthat/
!/tests/testthat/*.[Rr]
!/vignettes/
!/vignettes/*.Rmd

# installed recipes, registries and scripts
!/inst/
!/inst/cleaning/
!/inst/cleaning/*.yml
!/inst/cleaning/*.yaml
!/inst/extdata/
!/inst/extdata/*.yml
!/inst/extdata/*.yaml
!/inst/recipes/
!/inst/recipes/*.yml
!/inst/recipes/*.yaml
!/inst/recipes/taxonomies/
!/inst/recipes/taxonomies/*.yml
!/inst/recipes/taxonomies/*.yaml
!/inst/schema/
!/inst/schema/CANONICAL_SCHEMA.md
!/inst/schema/*.yml
!/inst/schema/*.yaml
!/inst/scripts/
!/inst/scripts/*.[Rr]
!/inst/scripts/verification/
!/inst/scripts/verification/*.[Rr]

# keep the pre-rendered vignettes and their package index
!/inst/doc/
!/inst/doc/*.R
!/inst/doc/*.Rmd
!/inst/doc/*.html
!/build/
!/build/vignette.rds
