^(?!(?:DESCRIPTION|NAMESPACE|LICENSE|NEWS\.md|README\.md)$|(?:R|man|tests|vignettes|inst|build)(?:/|$))
^R/(?![^/]+\.R$)
^man/(?![^/]+\.Rd$)
^tests/(?!(?:testthat(?:/[^/]+\.R)?|testthat\.R)$)
^vignettes/(?![^/]+\.Rmd$)
^inst/(?!(?:cleaning|doc|extdata|recipes|schema|scripts)(?:/|$))
^inst/(?:cleaning|extdata)/(?![^/]+\.ya?ml$)
^inst/doc/(?![^/]+\.(?:R|Rmd|html)$)
^inst/recipes/(?!(?:[^/]+\.ya?ml|taxonomies(?:/[^/]+\.ya?ml)?)$)
^inst/schema/(?![^/]+\.(?:md|ya?ml)$)
^inst/scripts/(?!(?:[^/]+\.R|verification(?:/[^/]+\.R)?)$)
^build/(?!vignette\.rds$)
